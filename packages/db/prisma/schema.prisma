generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  HOMEOWNER
  CONTRACTOR
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  phone         String?
  image         String?
  role          UserRole
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  notifyListingStatus Boolean @default(true)
  notifyOffers        Boolean @default(true)
  notifyAppointments  Boolean @default(true)
  notifySavedSearch   Boolean @default(true)

  accounts          Account[]
  sessions          Session[]
  listings          Listing[]
  offers            Offer[]
  pushTokens        PushToken[]
  contractorProfile ContractorProfile?
  blogPosts         BlogPost[]
  announcements     Announcement[]
  contractorReviews Review[]           @relation("ContractorReviews")
  reviewsWritten    Review[]           @relation("ReviewerReviews")
  savedSearches     SavedSearch[]
  portfolioItems    PortfolioItem[]

  @@map("users")
}

model SavedSearch {
  id              String   @id @default(cuid())
  userId          String
  name            String
  province        String?
  q               String?
  maxBuildingAge  Int?
  minSquareMeters Int?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("saved_searches")
}

model PortfolioItem {
  id             String   @id @default(cuid())
  contractorId   String
  title          String
  description    String?  @db.Text
  beforeImageUrl String?
  afterImageUrl  String?
  createdAt      DateTime @default(now())

  contractor User @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@map("portfolio_items")
}

enum AppointmentStatus {
  PROPOSED
  CONFIRMED
  CANCELLED
}

model Appointment {
  id          String            @id @default(cuid())
  offerId     String
  scheduledAt DateTime
  location    String?
  note        String?           @db.Text
  status      AppointmentStatus @default(PROPOSED)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@map("appointments")
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_tokens")
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
  CLOSED
}

model Listing {
  id            String        @id @default(cuid())
  listingNumber String        @unique
  ownerId       String
  title         String
  description   String        @db.Text
  province      String
  district      String
  squareMeters  Int
  buildingAge   Int
  floorCount    Int
  unitCount     Int
  priceMin      Int
  priceMax      Int
  coverImageUrl String?
  photos        String[]      @default([])
  latitude      Float?
  longitude     Float?
  viewCount     Int           @default(0)
  status        ListingStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  owner  User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  offers Offer[]

  @@map("listings")
}

enum OfferStatus {
  PENDING
  INTERESTED
  DECLINED
  WITHDRAWN
}

model Offer {
  id                String      @id @default(cuid())
  listingId         String
  contractorId      String
  priceMin          Int
  priceMax          Int
  durationMonths    Int?
  note              String?     @db.Text
  status            OfferStatus @default(PENDING)
  contactResolvedAt DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  listing      Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  contractor   User          @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  review       Review?
  appointments Appointment[]

  @@unique([listingId, contractorId])
  @@map("offers")
}

model Review {
  id           String   @id @default(cuid())
  offerId      String   @unique
  contractorId String
  reviewerId   String
  rating       Int
  comment      String?  @db.Text
  createdAt    DateTime @default(now())

  offer      Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  contractor User  @relation("ContractorReviews", fields: [contractorId], references: [id], onDelete: Cascade)
  reviewer   User  @relation("ReviewerReviews", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

enum ContractorDocumentType {
  VERGI_LEVHASI
  TICARET_SICIL_GAZETESI
  TICARET_ODASI_KAYDI
  IMZA_SIRKULERI
  FAALIYET_BELGESI
}

enum ContractorDocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ContractorVerificationStatus {
  INCOMPLETE
  PENDING
  APPROVED
  REJECTED
}

model ContractorProfile {
  id          String  @id @default(cuid())
  userId      String  @unique
  companyName String?
  about       String? @db.Text

  /// Müteahhitlik Yetki Belgesi Numarası — YAMBİS'te tek bir firmaya aittir.
  mybn String? @unique

  /// Derived from the document statuses; `verified` mirrors it for public badges.
  verificationStatus ContractorVerificationStatus @default(INCOMPLETE)
  verificationNote   String?                      @db.Text
  verified           Boolean                      @default(false)
  submittedAt        DateTime?
  reviewedAt         DateTime?
  updatedAt          DateTime                     @updatedAt

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents ContractorDocument[]

  @@map("contractor_profiles")
}

model ContractorDocument {
  id         String                   @id @default(cuid())
  profileId  String
  type       ContractorDocumentType
  url        String
  fileName   String
  mimeType   String
  size       Int
  status     ContractorDocumentStatus @default(PENDING)
  reviewNote String?                  @db.Text
  reviewedAt DateTime?
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt

  profile ContractorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  /// One current file per document type; re-uploading replaces the previous one.
  @@unique([profileId, type])
  @@map("contractor_documents")
}

model BlogPost {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  excerpt         String   @db.Text
  body            String   @db.Text
  coverImageUrl   String?
  category        String   @default("genel")
  tags            String[] @default([])
  metaDescription String?  @db.Text
  province        String?
  district        String?
  published       Boolean  @default(false)
  authorId        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([published, createdAt])
  @@index([province, district])
  @@map("blog_posts")
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String   @db.Text
  imageUrl  String?
  linkUrl   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([published, createdAt])
  @@map("announcements")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
